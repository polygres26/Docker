<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nexagres</groupId>
  <artifactId>nexagres-migration</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>nexagres-migration</name>
  <description>Massively-parallel, low-downtime migration connectors (MongoDB change streams,
    and future DynamoDB/MySQL/Oracle/SQL Server sources) writing into a running Polywire instance
    over Polywire's own native gRPC driver (QueryService.Execute), never a direct JDBC backdoor
    to the target Postgres, so every migration write goes through Polywire's real firewall/QoS/
    cache-invalidation pipeline like any other client. Independent standalone module, sibling to
    nexagres-wire and nexagres-advisor in this repo; depends on nexagres-wire only to reuse its
    already-generated QueryService gRPC stub classes (com.nexagres.wire.grpc.proto.*), not any of
    wire's internal package-private classes.</description>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.3</junit.version>
    <!-- Kept in lockstep with wire's own mongodb-driver-sync version (there test-scope only;
         see that pom's own comment for why: mongowire itself only needs org.mongodb:bson,
         BSON-codec-only). This module needs the REAL client, compile-scope, since MongoSource
         connects to a genuine SOURCE MongoDB deployment as a CDC consumer, a different use case
         from anything wire itself does. -->
    <mongodb-driver-sync.version>5.5.1</mongodb-driver-sync.version>
    <!-- Matches wire/pom.xml's own awssdk.version exactly (there test-scope only, used to
         validate dynamowire's wire protocol against a real AWS SDK client; see that pom's own
         dependency comment). This module needs it compile-scope: DynamoSource connects to a
         genuine SOURCE DynamoDB deployment (and its Streams) as a CDC consumer, a different use
         case from anything wire itself does. -->
    <awssdk.version>2.46.7</awssdk.version>
  </properties>

  <dependencies>
    <!-- Reuses nexagres-wire's already-generated QueryService/ExecuteRequest/ExecuteResponse gRPC
         stub classes (com.nexagres.wire.grpc.proto.*) and transitively brings in the matching
         grpc-stub/grpc-netty-shaded/grpc-protobuf runtime, org.mongodb:bson, the postgresql JDBC
         driver, and slf4j-simple, all real, compile-scope dependencies of wire's own pom.xml,
         not duplicated here. Deliberately depends on the WHOLE wire jar rather than a
         hand-extracted proto-only artifact, to guarantee these stub classes can never drift from
         what a real running Polywire instance's gRPC server actually implements: both come from
         the exact same build. -->
    <dependency>
      <groupId>com.nexagres</groupId>
      <artifactId>nexagres-wire</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <!-- NOT transitively available from nexagres-wire above; wire keeps this test-scope only
         (see its own pom's comment), so this module's own real, compile-scope need for it (a
         genuine client connecting to a SOURCE MongoDB deployment) has to be declared here. -->
    <!-- Streams operations (DescribeStream/GetShardIterator/GetRecords) live under this same
         artifact's software.amazon.awssdk.services.dynamodb.streams package; AWS SDK v2 does not
         ship a separate dynamodb-streams artifact. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
      <version>${awssdk.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mongodb</groupId>
      <artifactId>mongodb-driver-sync</artifactId>
      <version>${mongodb-driver-sync.version}</version>
    </dependency>
    <!-- Matches wire/pom.xml's own mysql-connector-j version exactly (there compile-scope,
         pinned specifically at 8.4.0 because newer 9.x releases dropped client-side
         mysql_native_password support mywire's own SERVER-side handshake relies on; that concern
         doesn't apply here, since MySqlSource is a plain JDBC CLIENT authenticating however the
         real source MySQL server wants, but staying in lockstep avoids two different driver
         versions/behaviors for the same vendor in this repo for no real reason). -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.4.0</version>
    </dependency>
    <!-- Real MySQL binlog (ROW-format) protocol client; a mature, MIT-licensed, actively
         maintained library (originally shyiko/mysql-binlog-connector-java, now maintained under
         Zendesk's groupId), added as a normal Maven dependency, not vendored/copied source;
         distinct from this session's earlier, deliberate decision NOT to reuse Dsync's own
         AGPL-3.0 source, which was about copying code, not about depending on OSS libraries at
         all. Parsing MySQL's binary replication protocol by hand would be real, unnecessary
         reinvention of a well-solved problem. -->
    <dependency>
      <groupId>com.zendesk</groupId>
      <artifactId>mysql-binlog-connector-java</artifactId>
      <version>0.29.2</version>
    </dependency>
    <!-- Matches wire/pom.xml's own mssql-jdbc version exactly, same lockstep reasoning as
         mysql-connector-j above. SQL Server's own Change Data Capture feature (cdc.fn_cdc_get_all_changes_*,
         sys.fn_cdc_get_max_lsn/increment_lsn) is queried through plain JDBC; no separate CDC
         client library needed, unlike MySQL's binlog or MongoDB's change streams. -->
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <version>12.8.1.jre11</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <!-- Same add-opens set wire's own pom.xml carries for its test JVM (see that pom's own
               comment); needed here too because this module's tests pull in ignite-core
               transitively via nexagres-wire, and IgniteJdbcThinDriver's static initializer
               (registered as a java.sql.Driver, so DriverManager loads it eagerly on ANY
               getConnection call in this JVM, not just an Ignite-specific one) throws without
               these under the module system's default reflection restrictions on JDK 17+;
               confirmed live, not a hypothetical: every DriverManager.getConnection call in this
               module's tests failed with NoClassDefFoundError before this was added. -->
          <argLine>
            --add-opens=java.base/jdk.internal.access=ALL-UNNAMED
            --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED
            --add-opens=java.base/jdk.internal.ref=ALL-UNNAMED
            --add-opens=java.base/java.lang=ALL-UNNAMED
            --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
            --add-opens=java.base/java.io=ALL-UNNAMED
            --add-opens=java.base/java.nio=ALL-UNNAMED
            --add-opens=java.base/java.util=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent.locks=ALL-UNNAMED
            --add-opens=java.base/java.math=ALL-UNNAMED
            --add-opens=java.base/java.time=ALL-UNNAMED
            --add-opens=java.base/java.text=ALL-UNNAMED
            --add-opens=java.base/java.net=ALL-UNNAMED
            --add-opens=java.sql/java.sql=ALL-UNNAMED
            --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
          </argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
