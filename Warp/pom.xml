<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.sayonora</groupId>
  <artifactId>sayonora-warp</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>sayonora-warp</name>
  <description>Warp: a mid-tier, Postgres-only database gateway speaking Oracle TNS/TTC,
    Postgres wire protocol v3, and MySQL client/server protocol to clients — ported from Omnigate
    (com.omnigate.*) into com.sayonora.wire.*, independent standalone module, sibling to
    sayonora-dms in this repo.</description>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <postgresql.version>42.7.4</postgresql.version>
    <calcite.version>1.42.0</calcite.version>
    <guava.version>33.2.1-jre</guava.version>
    <jackson.annotations.version>2.20</jackson.annotations.version>
    <snakeyaml.version>2.3</snakeyaml.version>
    <ignite.version>2.18.0</ignite.version>
    <!-- ignite-aws/ignite-gce stopped publishing after 2.11.1 (verified against Maven Central,
         no 2.18.0 artifact exists for either); ignite-azure-ext is a separate ignite-extensions
         release line, last published against ignite-core 2.13.0 (provided scope). All three still
         only depend on TcpDiscoveryIpFinderAdapter, a stable SPI surface unchanged across the 2.x
         line — see WarpCluster's javadoc for the full verification trail and the version-skew
         caveat this pin carries. -->
    <ignite.aws.version>2.11.1</ignite.aws.version>
    <ignite.gce.version>2.11.1</ignite.gce.version>
    <ignite.azure.version>1.0.0</ignite.azure.version>
    <slf4j.version>2.0.16</slf4j.version>
    <junit.version>5.11.3</junit.version>
    <ojdbc.version>23.8.0.25.04</ojdbc.version>
    <mssqljdbc.version>12.8.1.jre11</mssqljdbc.version>
    <!-- Pinned to a version that still implements mysql_native_password client-side.
         Oracle removed that plugin from mysql-connector-j starting around 9.x following the
         server-side deprecation, and Warp's mywire currently only implements the
         mysql_native_password handshake (real, confirmed working; tests/python/test_mywire.py
         already covers it against PyMySQL, whose Python driver kept native-password support).
         Adding caching_sha2_password (the modern default, RSA/SHA256 challenge-response) is a
         separate, larger piece of work than this test dependency choice. -->
    <mysqlconnector.version>8.4.0</mysqlconnector.version>
    <!-- AWS SDK v2, test-scope only. Same rationale as ojdbc11/mssql-jdbc/mysql-connector-j
         above: a real client's own request signing (SigV4) and JSON parsing is the only thing
         that actually validates dynamowire's/sqswire's wire-level responses, not a hand-written
         HTTP client that only checks what we already assumed the shape should be. -->
    <awssdk.version>2.46.7</awssdk.version>
    <!-- Runtime gRPC line. Must match what google-cloud-spanner-jdbc (grpc-xds/alts/... 1.82.2)
         brings, otherwise grpc-xds's NameResolverProviders fail with NoClassDefFoundError against an
         older grpc-api (ServiceConfigurationError on any ManagedChannel). Enforced via the grpc-bom
         import in dependencyManagement below. -->
    <grpc.version>1.82.2</grpc.version>
    <!-- protoc-gen-grpc-java codegen plugin; generated stubs are wire/API compatible with the newer runtime. -->
    <grpc.plugin.version>1.68.1</grpc.plugin.version>
    <protobuf.version>3.25.5</protobuf.version>
    <gson.version>2.11.0</gson.version>
    <nimbus-jose-jwt.version>9.37.3</nimbus-jose-jwt.version>
    <jetty.version>11.0.24</jetty.version>
    <hikaricp.version>5.1.0</hikaricp.version>
    <opentelemetry.version>1.43.0</opentelemetry.version>
    <!-- Kept in lockstep with mongodb-driver-sync's own version below (both org.mongodb
         artifacts): a mismatch here is a real, silent binary-incompatibility trap. An older
         bson.jar on the classpath alongside a newer mongodb-driver-sync produced a genuine
         NoSuchMethodError (org.bson.ByteBuf.putInt(int)) at runtime, not a compile-time error,
         caught by MongoErrorMappingIntegrationTest actually running against a real driver. -->
    <bson.version>5.5.1</bson.version>
    <!-- S3/Kafka/Cassandra/Splunk connector work (com.sayonora.wire.core.connector.{s3,kafka,
         cassandra,splunk}), ported from the sibling ThinkingSense project's own real, tested
         connectors, same versions ThinkingSense pinned, reconciled against Warp's own existing
         pins where they already overlap (S3 reuses awssdk.version above, since the DynamoDB work
         already established that AWS SDK v2 line on this classpath; Splunk needs no version
         property at all, see the splunk dependency comment). -->
    <parquet.version>1.17.1</parquet.version>
    <hadoop.common.version>3.5.0</hadoop.common.version>
    <commons.csv.version>1.14.1</commons.csv.version>
    <commons.io.version>2.20.0</commons.io.version>
    <kafka.clients.version>4.3.1</kafka.clients.version>
    <cassandra.driver.version>4.17.0</cassandra.driver.version>
    <!-- The broader JDBC-dialect catalog (BackendDriverRegistry#driverClassNameFor /
         BackendTarget#dialect()) — real, bundled drivers, same versions the sibling ThinkingSense
         project pinned and proved these load against. Reflectively loaded (Class.forName) only
         when an operator actually registers a backend of that dialect, so these are real, needed
         dependencies for the feature to WORK (not just compile) the moment WARP_BACKENDS names one
         of these URL prefixes — unlike the connector work above, nothing here is test-scope only. -->
    <snowflake.jdbc.version>3.24.2</snowflake.jdbc.version>
    <redshift.jdbc.version>2.1.0.33</redshift.jdbc.version>
    <bigquery.jdbc.version>0.3.0</bigquery.jdbc.version>
    <!-- Databricks' own JDBC driver ships under Databricks' JDBC Driver License Agreement for
         Non-Warranted Programs, not Apache-2.0/permissive like the others in this list — it's the
         only way to reach Databricks over JDBC at all. Confirmed the same real deviation the
         sibling ThinkingSense project already accepted for this same driver. -->
    <databricks.jdbc.version>2.7.3</databricks.jdbc.version>
    <clickhouse.jdbc.version>0.10.0</clickhouse.jdbc.version>
    <pinot.jdbc.version>1.5.1</pinot.jdbc.version>
    <!-- IBM's Db2 jcc driver, same non-Apache-license caveat as Databricks above — the only way
         to reach Db2 over JDBC. -->
    <db2.jcc.version>12.1.5.0</db2.jcc.version>
    <vertica.jdbc.version>25.3.0-0</vertica.jdbc.version>
    <singlestore.jdbc.version>1.2.12</singlestore.jdbc.version>
    <hana.jdbc.version>2.29.11</hana.jdbc.version>
    <teradata.jdbc.version>20.00.00.54</teradata.jdbc.version>
    <spanner.jdbc.version>2.42.0</spanner.jdbc.version>
    <!-- io.trino:trino-jdbc — Apache-2.0, a real Maven Central artifact with NO transitive
         dependencies at all (a fully self-contained jar), so no exclusions/version-conflict risk
         from adding it. -->
    <trino.jdbc.version>483</trino.jdbc.version>
    <sqlite.jdbc.version>3.53.4.0</sqlite.jdbc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <!-- TranslationCache's fallback LLM translator's HTTP client, and the rollup config's/access
           policy's JSON bits — Apache-2.0. -->
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>
    <dependency>
      <!-- com.sayonora.wire.http.auth.AccessContextResolver — real JWT parsing/signature
           verification (JWS/JWK/JWKS) for OAuth2/OIDC bearer tokens (Okta, Auth0, Azure AD, any
           standards-compliant IdP) — the standard JVM library for this, not a hand-rolled JWT
           parser (Apache-2.0). -->
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>${nimbus-jose-jwt.version}</version>
    </dependency>
    <dependency>
      <!-- com.sayonora.wire.rollup.RollupConfig — real YAML parsing for the rollup definitions
           config file, not a hand-rolled subset parser (Apache-2.0). -->
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${snakeyaml.version}</version>
    </dependency>
    <dependency>
      <!-- com.sayonora.wire.core.RollupStage: reuses Calcite's own materialized-view substitution
           machinery (RelOptMaterialization/RelOptMaterializations) to decide whether an incoming
           aggregate query can be rewritten to hit a rollup table instead of the full source table —
           real, tested query-rewrite logic, not hand-rolled SQL rewriting. Apache-2.0. -->
      <groupId>org.apache.calcite</groupId>
      <artifactId>calcite-core</artifactId>
      <version>${calcite.version}</version>
    </dependency>
    <dependency>
      <!-- Pinned explicitly, same "nearest wins" reasoning Omnigate's pom.xml documents: without
           this, some other dependency's older jackson-annotations gets picked by Maven's mediation
           and calcite-core's own SqlStdOperatorTable bootstrap can fail at runtime looking for an
           enum member the older version lacks. -->
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>${jackson.annotations.version}</version>
    </dependency>
    <dependency>
      <!-- Pinned explicitly: grpc-netty-shaded transitively pulls Guava's "-android" flavor, which
           calcite-core's SqlStdOperatorTable is incompatible with at runtime (IncompatibleClassChangeError,
           see Omnigate's pom.xml for the full live-found explanation) — forcing the "-jre" flavor here. -->
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>${guava.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <!-- generated grpc stubs reference @Generated, dropped from java.* since JDK 11 -->
      <groupId>org.apache.tomcat</groupId>
      <artifactId>annotations-api</artifactId>
      <version>6.0.53</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- Warp's original, still-primary backend driver. Warp used to be Postgres-only
           end to end (BackendRegistry/BackendConnectionPools/BackendTarget); Oracle is now a
           real second backend driver too (see the ojdbc11 dependency below, promoted from
           test-only scope), following the sibling Omnigate project's own proven
           config-record-plus-URL-prefix-dispatch shape rather than a polymorphic per-engine
           class hierarchy. MySQL/SQL Server as real backends are a real, scoped follow-up, not
           done yet; see docs/WARP_GUIDE.md's own federation section. -->
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>
    <dependency>
      <!-- Promoted from test-only scope: Warp's second real backend driver. BackendTarget/
           BackendConnectionPools/ShardJoinExecutor/SchemaFederationStage/RollupStage/
           XaBackendFactory all now recognize a jdbc:oracle: BackendTarget as a real read/write
           data-plane backend (cross-engine JOIN federation and XA/2PC included), not just
           something orawire's own wire-protocol frontend decodes against. The wire-protocol
           frontend code (orawire/) is unrelated; it never touches this driver at all. -->
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>${ojdbc.version}</version>
    </dependency>
    <dependency>
      <!-- Promoted from test-only scope: Warp's third real backend driver, same shape and
           reasoning as ojdbc11 above; BackendTarget/BackendConnectionPools/ShardJoinExecutor/
           SchemaFederationStage/RollupStage/XaBackendFactory all now recognize a jdbc:sqlserver:
           BackendTarget too. -->
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <version>${mssqljdbc.version}</version>
    </dependency>
    <dependency>
      <!-- Promoted from test-only scope: Warp's fourth real backend driver, same shape as
           ojdbc11/mssql-jdbc above, for jdbc:mysql:/jdbc:mariadb: BackendTargets. This is the real
           Oracle-published MySQL Connector/J (not MariaDB's own driver, which is what the sibling
           Omnigate project found live has no usable XADataSource); com.mysql.cj.jdbc.
           MysqlXADataSource IS real and present in this jar. See XaBackendFactory's own javadoc
           for whether it actually works end to end, live-verified, not assumed from its mere
           existence. -->
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysqlconnector.version}</version>
    </dependency>
    <dependency>
      <!-- com.sayonora.wire.mongowire's BSON codec — the official MongoDB Java driver's small,
           standalone BSON library (Apache-2.0), NOT the mongo-java-driver client itself (that
           would be a MongoDB *client* dependency, nonsensical for something acting as a MongoDB
           *server*). Used purely for OP_MSG document (de)serialization; the wire-protocol framing
           and Postgres translation in mongowire are hand-written, following mongo-java-server's
           postgresql-backend module (BSD-3-Clause) as a design/structure reference — see
           MongoWireSessionHandler's javadoc. -->
      <groupId>org.mongodb</groupId>
      <artifactId>bson</artifactId>
      <version>${bson.version}</version>
    </dependency>
    <dependency>
      <!-- Apache Ignite core (com.sayonora.wire.cluster), Apache-2.0 — embedded in-process
           (Ignition.start(), not a separate server) for CacheStage's cluster-aware cache-aside
           result cache. Pinned to the 2.x line deliberately, not 3.x (see WarpCluster's javadoc). -->
      <groupId>org.apache.ignite</groupId>
      <artifactId>ignite-core</artifactId>
      <version>${ignite.version}</version>
    </dependency>
    <dependency>
      <!-- TcpDiscoveryS3IpFinder (WARP_CLUSTER_DISCOVERY=s3) — nodes self-register their IP
           in an S3 bucket on startup instead of a static host:port list, so replaced instances
           don't break discovery. Real Maven Central coordinate verified directly (see
           ignite.aws.version's comment above): ignite-aws stopped publishing after 2.11.1, there
           is no 2.18.0 artifact, despite that being the natural guess given ignite-core's own
           pin. Excludes its own transitive ignite-core 2.11.1 — Maven's nearest-wins mediation
           would already prefer this project's direct 2.18.0 dependency, but the exclusion makes
           that explicit rather than relying on mediation order. -->
      <groupId>org.apache.ignite</groupId>
      <artifactId>ignite-aws</artifactId>
      <version>${ignite.aws.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.ignite</groupId>
          <artifactId>ignite-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- TcpDiscoveryGoogleStorageIpFinder (WARP_CLUSTER_DISCOVERY=gcs) — same
           self-registration pattern as S3, backed by Cloud Storage. Same version-skew situation
           as ignite-aws: last published at 2.11.1, no 2.18.0 artifact on Maven Central. -->
      <groupId>org.apache.ignite</groupId>
      <artifactId>ignite-gce</artifactId>
      <version>${ignite.gce.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.ignite</groupId>
          <artifactId>ignite-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- TcpDiscoveryAzureBlobStoreIpFinder (WARP_CLUSTER_DISCOVERY=azure) — ships from a
           *different* release line than ignite-aws/ignite-gce: it was moved out of mainline
           Apache Ignite into the separate apache/ignite-extensions repo, published under artifact
           id ignite-azure-ext (still groupId org.apache.ignite), last released as 1.0.0 against
           ignite-core 2.13.0 (provided scope there, meaning it expects the embedding project to
           supply its own ignite-core — exactly this project's situation). Verified for real: the
           1.0.0 jar was downloaded and inspected directly
           (org/apache/ignite/spi/discovery/tcp/ipfinder/azure/TcpDiscoveryAzureBlobStoreIpFinder.class
           is really in it), not assumed from a package name. -->
      <groupId>org.apache.ignite</groupId>
      <artifactId>ignite-azure-ext</artifactId>
      <version>${ignite.azure.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.apache.ignite</groupId>
          <artifactId>ignite-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
      <version>${opentelemetry.version}</version>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
      <version>${opentelemetry.version}</version>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikaricp.version}</version>
    </dependency>
    <dependency>
      <!-- Embedded Jetty for the /metrics endpoint only (com.sayonora.wire.http, once ported) —
           admin UI/API/auth/SCIM pieces of Omnigate's http package are explicitly out of scope. -->
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-server</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-servlet</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-util</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- ojdbc11/mssql-jdbc/mysql-connector-j no longer need their own test-scope entries here;
         they're all real, compile-scope backend driver dependencies now (see above); their own
         wire-encoding-validation role for orawire's/mssqlwire's/mywire's protocol decoders (a real
         client's own wire encoding is the only thing that actually validates a byte-level protocol
         decoder; see MssqlJdbcIntegrationTest/MySqlJdbcIntegrationTest) is covered by those same
         compile-scope dependencies now, no separate test-scope copies needed. -->
    <dependency>
      <!-- Compile scope (was test-only): com.sayonora.wire.core.connector.dynamodb reads a real
           DynamoDB table as a federated SchemaFederationStage mount. Same 2.46.7 version the
           ported ThinkingSense connector was proven against, and the same awssdk.version property
           sqs/dynamowire's own test clients already use, so there is exactly one AWS SDK v2
           version on the classpath. -->
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
      <version>${awssdk.version}</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>sqs</artifactId>
      <version>${awssdk.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Compile scope: com.sayonora.wire.core.connector.s3.S3CompatibleObjectFetcher needs real
           S3 object download (SigV4 request signing), same AWS SDK v2 line/version the DynamoDB
           connector above already established on this classpath (awssdk.version), reused verbatim
           rather than introducing ThinkingSense's own separate aws.sdk.s3.version pin. -->
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${awssdk.version}</version>
    </dependency>
    <dependency>
      <!-- Real Parquet reader (org.apache.parquet.hadoop.ParquetFileReader) via the InputFile SPI
           over an in-memory byte buffer, exactly as ThinkingSense's S3Table does, no Hadoop
           filesystem/Path abstraction needed since S3Table downloads one object fully into memory
           first (see ByteArrayInputFile). Apache-2.0. -->
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-hadoop</artifactId>
      <version>${parquet.version}</version>
    </dependency>
    <dependency>
      <!-- Real RFC 4180 CSV parsing for S3Table's csv format, not hand-rolled. Apache-2.0. -->
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>${commons.csv.version}</version>
    </dependency>
    <dependency>
      <!-- commons-csv 1.14.1 needs commons-io 2.20.0's AbstractStreamBuilder.getReader(),
           calcite-core transitively pulls an older commons-io that lacks it, a real
           NoSuchMethodError the moment CSVParser.parse(...) runs (confirmed via ThinkingSense's own
           pom.xml comment for the identical finding). Pinned explicitly, "nearest wins". -->
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>${commons.io.version}</version>
    </dependency>
    <dependency>
      <!-- A real runtime dependency despite S3Table's Parquet path using only the non-Hadoop
           InputFile/ParquetConfiguration SPI: parquet-hadoop's own ParquetReadOptions.Builder
           constructor unconditionally reflection-probes for
           org.apache.hadoop.mapreduce.lib.input.FileInputFormat and raises a hard
           NoClassDefFoundError (not a caught ClassNotFoundException) when it's absent, found live
           in ThinkingSense, ported here as the same required pair of minimal Hadoop jars. -->
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <version>${hadoop.common.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-mapreduce-client-core</artifactId>
      <version>${hadoop.common.version}</version>
    </dependency>
    <dependency>
      <!-- com.sayonora.wire.core.connector.kafka.KafkaTable: real, bounded-snapshot Kafka topic
           reads (see that package's javadoc for why this is bounded, not continuous-streaming
           SQL). Apache Kafka's official Java client, no Scala/Spark dependency. Apache-2.0. -->
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>${kafka.clients.version}</version>
    </dependency>
    <dependency>
      <!-- com.sayonora.wire.core.connector.cassandra: DataStax's official Cassandra Java driver,
           real column-metadata introspection (see that package's javadoc for why Cassandra doesn't
           need Mongo/DynamoDB's declared-field-list workaround). Apache-2.0. -->
      <groupId>com.datastax.oss</groupId>
      <artifactId>java-driver-core</artifactId>
      <version>${cassandra.driver.version}</version>
    </dependency>
    <dependency>
      <groupId>com.datastax.oss</groupId>
      <artifactId>java-driver-query-builder</artifactId>
      <version>${cassandra.driver.version}</version>
    </dependency>
    <!-- com.sayonora.wire.core.connector.splunk needs no dependency of its own beyond Gson, which
         is already a main-scope dependency above (TranslationCache's HTTP client); Splunk access
         is plain java.net.http.HttpClient + Gson JSON parsing, same as ThinkingSense's own
         SplunkTable. -->

    <dependency>
      <!-- Real opensearch-py-equivalent Java client, test scope only. oswire's existing tests
           used raw HttpURLConnection; this is the first real OpenSearch client library any
           oswire test has been verified against. -->
      <groupId>org.opensearch.client</groupId>
      <artifactId>opensearch-java</artifactId>
      <version>2.19.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.opensearch.client</groupId>
      <artifactId>opensearch-rest-client</artifactId>
      <version>2.12.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- The real MongoDB client driver, test scope only. The main-scope org.mongodb:bson
           dependency elsewhere in this file is BSON-codec-only, explicitly not this; see that
           dependency's own comment. Was briefly promoted to a real main-scope dependency for a
           CDC forward-sync worker that lived directly in this module (needed a real client to
           connect to a SOURCE MongoDB deployment); that worker has since moved to the separate
           sayonora-migration module (see its own pom.xml), which depends on this module's own
           gRPC stub classes instead of duplicating them, so wire itself no longer needs a real
           Mongo client of its own; back to test-only here. This is the first real MongoDB client
           library any mongowire test was verified against (mongowire had no integration test at
           all before that). MongoDB as a real Warp BACKEND ENGINE (via Calcite's own
           calcite-mongodb adapter, i.e. querying Mongo the way SchemaFederationStage queries a
           SQL backend) was attempted and reverted; see SchemaFederationStage's own git history/
           commit message for the full real finding: calcite-mongodb 1.42.0 is compiled against
           mongodb-driver-sync 4.10.2 (confirmed via its own real pom.xml) and throws a real
           NoSuchMethodError against this project's required 5.5.1 (needed for mongowire/bson's
           own lockstep-version requirement above), a genuine, unresolved binary-incompatible
           version conflict between the two real requirements, not a bug in this project's own
           code. -->
      <groupId>org.mongodb</groupId>
      <artifactId>mongodb-driver-sync</artifactId>
      <version>${bson.version}</version>
    </dependency>
    <dependency>
      <!-- Compile scope again: com.sayonora.wire.core.connector.mongo is a real Mongo backend
           connector (a plain ScannableTable over the sync driver's find(), NOT calcite-mongodb,
           whose 4.10.2-driver binary incompatibility described above is exactly why that adapter
           was reverted). Pinned to bson.version (5.5.1), not the 5.11.0 ThinkingSense's ported
           connector used: bson/driver-core/driver-sync must stay in lockstep (see bson.version's
           comment), and the connector only calls MongoClients.create/getCollection/find, all
           stable across 5.x. driver-core pinned explicitly so it can't drift transitively. -->
      <groupId>org.mongodb</groupId>
      <artifactId>mongodb-driver-core</artifactId>
      <version>${bson.version}</version>
    </dependency>
    <!-- Real Neo4j Bolt client, test only, per boltwire's own javadoc: Phase 1's Cypher support
         is deliberately narrow (RETURN literal only), but the wire protocol itself (handshake,
         HELLO auth, RUN/PULL/RECORD/SUCCESS framing, GOODBYE) is real Bolt 4.4, so a real driver
         is what proves it, not a hand rolled socket check. -->
    <dependency>
      <groupId>org.neo4j.driver</groupId>
      <artifactId>neo4j-java-driver</artifactId>
      <version>5.28.4</version>
      <scope>test</scope>
    </dependency>
    <!-- Real InfluxDB v1 HTTP/line protocol client, test only: influxwire speaks the real
         InfluxDB v1 /write and /query HTTP API (see InfluxWireServer's own javadoc), so this is
         what a real client actually sends against it. -->
    <dependency>
      <groupId>org.influxdb</groupId>
      <artifactId>influxdb-java</artifactId>
      <version>2.24</version>
      <scope>test</scope>
    </dependency>
    <!-- The broader JDBC-dialect catalog (BackendDriverRegistry#driverClassNameFor) — real,
         compile-scope (not test-scope, unlike the drivers above this comment, which only exist to
         validate a Warp-hosted wire protocol against a real client): these ARE the drivers Warp
         itself loads via Class.forName the moment an operator registers a backend of that dialect,
         so the feature genuinely works, not just compiles. See SourceDialect's own javadoc for the
         two connectors (Athena, Dremio) deliberately NOT added here, and why. -->
    <dependency>
      <groupId>net.snowflake</groupId>
      <artifactId>snowflake-jdbc</artifactId>
      <version>${snowflake.jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.amazon.redshift</groupId>
      <artifactId>redshift-jdbc42</artifactId>
      <version>${redshift.jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-bigquery-jdbc</artifactId>
      <version>${bigquery.jdbc.version}</version>
    </dependency>
    <!-- Ships under Databricks' own JDBC Driver License Agreement for Non-Warranted Programs, not
         Apache-2.0 — the only way to reach Databricks over JDBC at all. -->
    <dependency>
      <groupId>com.databricks</groupId>
      <artifactId>databricks-jdbc</artifactId>
      <version>${databricks.jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.clickhouse</groupId>
      <artifactId>clickhouse-jdbc</artifactId>
      <version>${clickhouse.jdbc.version}</version>
      <classifier>all</classifier>
    </dependency>
    <!-- Druid connects over Avatica remote (jdbc:avatica:remote:...); avatica-core is already a
         transitive dependency of calcite-core, so no dedicated Druid driver dependency is needed. -->
    <dependency>
      <groupId>org.apache.pinot</groupId>
      <artifactId>pinot-jdbc-client</artifactId>
      <version>${pinot.jdbc.version}</version>
    </dependency>
    <!-- Ships under IBM's Db2 jcc license, not Apache-2.0 — the only way to reach Db2 over JDBC. -->
    <dependency>
      <groupId>com.ibm.db2</groupId>
      <artifactId>jcc</artifactId>
      <version>${db2.jcc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.vertica.jdbc</groupId>
      <artifactId>vertica-jdbc</artifactId>
      <version>${vertica.jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.singlestore</groupId>
      <artifactId>singlestore-jdbc-client</artifactId>
      <version>${singlestore.jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sap.cloud.db.jdbc</groupId>
      <artifactId>ngdbc</artifactId>
      <version>${hana.jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.teradata.jdbc</groupId>
      <artifactId>terajdbc</artifactId>
      <version>${teradata.jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-spanner-jdbc</artifactId>
      <version>${spanner.jdbc.version}</version>
    </dependency>
    <!-- Apache-2.0, no transitive dependencies at all (a fully self-contained jar) — real Maven
         Central artifact, unlike ThinkingSense's own pom.xml, which references this driver's class
         name in code but never actually declared the dependency (confirmed absent there); added
         properly here rather than porting that gap. -->
    <dependency>
      <groupId>io.trino</groupId>
      <artifactId>trino-jdbc</artifactId>
      <version>${trino.jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.jdbc.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>sayonora-warp</finalName>
    <extensions>
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>0.6.1</version>
        <configuration>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.plugin.version}:exe:${os.detected.classifier}</pluginArtifact>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>compile-custom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <!-- Same add-opens set scripts/run.sh documents needing on JDK 17+ for embedded
               Ignite's reflective GridUnsafe bootstrap (module system blocks it by default) —
               only actually exercised by WarpClusterAzBackupPlacementTest, which is the one
               test class that starts real embedded Ignite nodes. -->
          <argLine>
            --add-opens=java.base/jdk.internal.access=ALL-UNNAMED
            --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED
            --add-opens=java.base/jdk.internal.ref=ALL-UNNAMED
            --add-opens=java.base/java.lang=ALL-UNNAMED
            --add-opens=java.base/java.lang.reflect=ALL-UNNAMED
            --add-opens=java.base/java.io=ALL-UNNAMED
            --add-opens=java.base/java.nio=ALL-UNNAMED
            --add-opens=java.base/java.util=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent.locks=ALL-UNNAMED
            --add-opens=java.base/java.math=ALL-UNNAMED
            --add-opens=java.base/java.time=ALL-UNNAMED
            --add-opens=java.base/java.text=ALL-UNNAMED
            --add-opens=java.base/java.net=ALL-UNNAMED
            --add-opens=java.sql/java.sql=ALL-UNNAMED
            --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
          </argLine>
        </configuration>
      </plugin>
      <plugin>
        <!-- Produces a runnable target/sayonora-warp.jar (all deps bundled) with
             com.sayonora.wire.server.Main as the entry point. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.sayonora.wire.server.Main</mainClass>
                  <!-- Real bug found via test harness instrumentation: dnsjava ships as a
                       multi-release jar, with its java.net.spi.InetAddressResolverProvider impl
                       under META-INF/versions/18/, but ManifestResourceTransformer doesn't carry
                       forward "Multi-Release: true" on its own. Without it, the shaded jar's
                       manifest omits that attribute, so on JDK 18+ the JVM only ever looks at the
                       jar's base (unversioned) tree, where dnsjava's provider class does not
                       exist, and every Warp startup that opens a Postgres/JDBC connection fails
                       fast with "ServiceConfigurationError: ... DnsjavaInetAddressResolverProvider
                       not found". Confirmed live: every WarpProcess launch in tests/python/ was
                       exiting with code 1 on this exact error before this fix. -->
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <!-- Without this, shading collapses every dependency's META-INF/services/java.sql.Driver
                     file into a single last-jar-wins copy, silently dropping either the Postgres or
                     Calcite JDBC driver's registration: found live, RollupStage's "jdbc:calcite:..."
                     connection failed with "No suitable driver found" because org.postgresql.Driver's
                     services file (packaged later) had overwritten Calcite's. ServicesResourceTransformer
                     merges same-named META-INF/services/* files across all jars instead of picking one. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
