advisor/web/dist/
advisor/web/.vite/
advisor/web/.oxlintrc.json.bak

wire/web/node_modules/
wire/web/dist/
wire/web/.vite/

docker/tests/python/.pytest_cache/
docker/tests/python/__pycache__/
docker/tests/python/venv/
docker/tests/python/.venv/

.DS_Store
*.log

.env
.env.local
