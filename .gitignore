target/
dependency-reduced-pom.xml
*.class

# Apache Ignite's own working directory, created wherever a JVM running sayonora-wire (or
# anything depending on it, like sayonora-dms's own migration-launching tests) happens to run
# from -- not a build artifact of any single module, so not scoped under target/.
ignite/

dms/web/node_modules/
dms/web/dist/
dms/web/.vite/
dms/web/.oxlintrc.json.bak

wire/web/node_modules/
wire/web/dist/
wire/web/.vite/

docker/tests/python/.pytest_cache/
docker/tests/python/__pycache__/
docker/tests/python/venv/
docker/tests/python/.venv/

.DS_Store
*.log

.env
.env.local
