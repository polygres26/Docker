# PolyAdvisor frontend -- the Vite/React SPA in Ferry/web, built to static files and served by
# nginx, which also proxies /api to the backend container (the same job Vite's own dev-server
# proxy does for `npm run dev` -- see Ferry/web/vite.config.ts's comment). Build context is the
# repo root -- see docker-compose.yml.

# ---- build stage ----
FROM node:22-alpine AS build
WORKDIR /build

# Dependency layer cached separately from source.
COPY Ferry/web/package.json Ferry/web/package-lock.json ./
RUN npm ci

COPY Ferry/web/ .
RUN npm run build

# ---- runtime stage ----
FROM nginx:1.27-alpine
COPY --from=build /build/dist /usr/share/nginx/html
COPY docker/ferry/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
